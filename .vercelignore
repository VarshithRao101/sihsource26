# Everything the read-only build does not need. Vercel caps a function bundle
# at 250 MB and this repository is several gigabytes with its engines and
# caches, so this file is what makes the deploy possible at all.

# The real environment. api/requirements.txt is the deployed one.
#
# ANCHORED WITH A LEADING SLASH, and it matters more here than anywhere else in
# this file. These patterns are gitignore-style: an unanchored "requirements.txt"
# matches at EVERY depth, so it excluded api/requirements.txt as well - the one
# file that installs fastapi - and every request to the deployed function died
# with ModuleNotFoundError: No module named 'fastapi'. The build itself
# succeeded, which is what made it hard to see.
/requirements.txt
/.venv/

# Simulation engines - Windows binaries, gigabytes, and unusable on Linux.
# Anchored for the same reason as above: these are repo-root directories, and
# unanchored "SFINCS/" is one case-fold away from also eating the sfincs
# cross-check output inside the committed demo run.
/DualSPHysics_v5.4/
/SFINCS/
/SFINCS_v2.4.0/
/Deltares License Software/

# Heavy inputs. The dam register is small and IS deployed; these are not.
data/dem/
data/worldpop/
data/observed/
data/surrogate/
data/labels/
data/roads/
# data/rivers/* rather than data/rivers/ - a bare directory exclusion cannot
# be undone by a negation beneath it, the same rule that silently dropped
# the demo run from git. rivers.json is 1.5 MB and the console's River tab
# is dead without it.
data/rivers/*
!data/rivers/rivers.json
data/roughness/
data/damage/
data/exposure/

# Trained model weights - torch is not installed on the deployed build.
modules/07_ml/models/

# Dev-only
tests/
integration/
docs/
.pytest_cache/
**/__pycache__/
*.pyc
secrets/
.env
