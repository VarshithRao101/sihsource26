data/**/*.shp
data/**/*.dbf
data/**/*.shx
data/**/*.sbn
data/**/*.sbx
data/**/*.prj
data/**/*.cpg
data/**/*.pdf

# but keep the folder structure and small vector files
!data/**/.gitkeep
!data/**/*.geojson

