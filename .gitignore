# generated runs - never commit these, they are large and regenerable.
# NOTE the trailing /* rather than a bare outputs/. Git cannot re-include a
# file whose PARENT DIRECTORY is excluded, so "outputs/" would silently kill
# both negations below and the demo run would only ever reach the index by
# git add -f. Excluding the contents instead leaves the directory itself
# includable, which is what makes the exception work.
outputs/*
# ...that exception: the primary demo run is committed so the read-only
# Vercel build has something real to show. 2.3 MB, solved on a real machine,
# contract-valid. It is the ONLY run that ships.
!outputs/chungthangdam_overtop_fast_002/

# raw downloads - shared via drive, not git
data/**/*.tif
data/**/*.tiff
data/**/*.nc
data/**/*.zip
data/**/*.osm.pbf
data/**/*.hgt

# large public reference downloads - fetch your own, see data/SOURCES.md
data/**/*.shp
data/**/*.dbf
data/**/*.shx
data/**/*.sbn
data/**/*.sbx
data/**/*.prj
data/**/*.cpg
data/**/*.pdf

# but keep the folder structure and small vector files
!data/**/.gitkeep
!data/**/*.geojson

# downloaded simulation engines - 1.7 GB, everyone installs their own
# Anchored with a leading slash: these are the engine installs at the REPO
# ROOT. Unanchored, "SFINCS*/" also matched outputs/<run>/sfincs/ - git on
# Windows compares ignore rules case-insensitively - and silently dropped the
# cross-check output that CSI 0.9607 is computed from.
/DualSPHysics_v5.4/
/Delft3D*/
/D-Flow*/
/Deltares*/
/SFINCS*/
*.msi
*.exe

# simulation engine working directories
modules/02_sph/cases/**/data/
modules/02_sph/cases/**/out/
modules/02_sph/cases/**/run.log
modules/02_sph/cases/**/*.bi4
modules/02_sph/cases/**/*.vtk
modules/03_delft3d/runs/**/*.nc
modules/03_delft3d/runs/**/DFM_OUTPUT*/

# python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# node
node_modules/
dist/
.vite/
*.log

# secrets - never commit
.env
.env.*
!.env.example          # the template is the one env file that IS committed
secrets/
*.pem
*credentials*.json
service-account*.json

# local virtualenv
.venv/

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# credential files
secrets/

# playwright e2e — dev only, the shipped frontend still has zero dependencies
tests/e2e/node_modules/
tests/e2e/report/
tests/e2e/test-results/
tests/e2e/package-lock.json

# conditioned DEM caches and aborted downloads - regenerable from the source
# DEM, and the rule in data/SOURCES.md is that nothing large is committed.
data/**/*.npz
data/**/*.partial

# cached OSM exposure pulls - regenerable from Overpass, and some are megabytes
data/exposure/**/exposure.json

# Babylon.js was vendored for the 3D scene, which has since been removed from
# the workflow page. The file is left on disk rather than deleted so the scene
# can be restored, but 8 MB of unused library does not belong in the history.
modules/05_frontend/vendor/
