# SIH26161 - credentials template.
#
#   cp .env.example .env          then fill in the values
#   python -m shared.creds        checks what is present, prints no secrets
#
# .env is in .gitignore. Never commit it. Never paste its contents into chat,
# a ticket, a screenshot or a slide. If a key does leak, revoke and reissue it
# rather than hoping.
#
# Tier 1 = a module cannot run without it.
# Tier 2 = a deliverable is weaker without it.
# Tier 3 = demo day only.


# ==========================================================================
# TIER 1
# ==========================================================================

# --- Google Earth Engine --------------------------------------------------
# Deliverable 4 of the problem statement ("near real-time flood analysis using
# Google Earth Engine") is entirely this. Module 06 and the SAR water
# classifier in module 07 both stop dead without it.
#
#   1. https://earthengine.google.com/signup/          register (noncommercial)
#   2. https://console.cloud.google.com/               create/pick a project
#   3. https://console.cloud.google.com/apis/library/earthengine.googleapis.com
#                                                      enable the Earth Engine API
#   4. https://console.cloud.google.com/iam-admin/serviceaccounts
#                                                      create a service account,
#                                                      role "Earth Engine Resource Writer",
#                                                      then Keys > Add key > JSON
#   5. https://code.earthengine.google.com/            register the service-account
#                                                      email to your EE project
#   6. save the JSON as secrets/ee-service-account.json (secrets/ is gitignored)
EE_PROJECT_ID=
EE_SERVICE_ACCOUNT_EMAIL=
EE_SERVICE_ACCOUNT_KEY=secrets/ee-service-account.json

# --- OpenTopography -------------------------------------------------------
# Direct SRTM / COP30 / ALOS download without going through GEE. This is our
# fallback path for module 01 and worth having even with GEE working.
#   https://portal.opentopography.org/  ->  myOpenTopo  ->  Request API key
OPENTOPOGRAPHY_API_KEY=

# --- NASA Earthdata Login -------------------------------------------------
# SRTM, NASADEM, ASTER GDEM, GPM IMERG rainfall.
#   https://urs.earthdata.nasa.gov/users/new
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Copernicus Data Space Ecosystem --------------------------------------
# Sentinel-1 SAR. This is the imagery the CSI validation number is measured
# against - the one real accuracy figure we will be able to quote.
#   1. https://dataspace.copernicus.eu/            register (free)
#   2. https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
#                                                  create an OAuth client
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- MapTiler -------------------------------------------------------------
# Satellite basemap for the dashboard. MapLibre itself needs no key, so the
# frontend degrades to OSM raster tiles without this rather than breaking.
#   https://cloud.maptiler.com/account/keys/
MAPTILER_API_KEY=


# ==========================================================================
# TIER 2
# ==========================================================================

# --- Bhuvan / ISRO --------------------------------------------------------
# CartoDEM 30 m and Indian thematic layers. Optional: FABDEM is a better DEM
# for flood work. Worth having purely as an "we used ISRO data" talking point.
#   https://bhuvan.nrsc.gov.in/  ->  register  ->  https://bhuvan-app3.nrsc.gov.in/data/
BHUVAN_API_KEY=

# --- Kaggle ---------------------------------------------------------------
# Free GPU (about 30 h/week) for training the FNO surrogate and the LSTM.
#   https://www.kaggle.com/settings  ->  API  ->  Create New Token (kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=


# ==========================================================================
# TIER 3
# ==========================================================================

# Set only if the backend is deployed somewhere for the pitch. Leaving this
# empty means the frontend talks to http://localhost:8000, which is what we
# want for a live demo anyway - no network, no surprises.
DEPLOY_BACKEND_URL=

# Delft3D FM - path to the D-Flow FM kernel / DIMR folder (NOT the licence
# manager). Leave blank if it is unpacked beside DualSPHysics_v5.4/ or on PATH.
# Check with: python -m modules.03_delft3d.engine
DELFT3D_HOME=
